# FastAPI server configuration
API_HOST=0.0.0.0
API_PORT=8000

# SambaNova's OpenAI-compatible endpoint defaults
OPENAI_API_KEY=replace-with-your-sambanova-key
OPENAI_API_URL=https://api.sambanova.ai/v1
OPENAI_MODEL=Meta-Llama-3.1-8B-Instruct
OPENAI_TRANSCRIPTION_MODEL=whisper-large-v3

# SQLite database location
DATABASE_URL=sqlite:///./todo.db

# Optional reference timestamp for resolving relative dates in LLM prompts
REFERENCE_DATETIME=

OUTPUT_DEBUG=0
